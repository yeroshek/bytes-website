#!/bin/zsh
# Runs videos/scene.swift: bytes-video capture|watch|record|setup|check <scene.yaml> [--full]
# Swift is compiled, so the runner is built into .build/ (gitignored) and rebuilt only when scene.swift changes.
set -eu
root=${0:A:h:h}
bin=$root/.build/bytes-video
if [[ ! -x $bin || $root/videos/scene.swift -nt $bin ]]; then mkdir -p $root/.build && swiftc -O $root/videos/scene.swift -o $bin; fi
cd $root
exec $bin "$@"
